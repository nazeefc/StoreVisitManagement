<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.storevisitmanagement.ui.auth.LoginFragment"
        android:label="LoginFragment"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_storeListFragment"
            app:destination="@id/storeListFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/storeListFragment"
        android:name="com.example.storevisitmanagement.ui.stores.StoreListFragment"
        android:label="StoreListFragment"
        tools:layout="@layout/fragment_store_list">
        <action
            android:id="@+id/action_storeListFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/storeListFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_storeListFragment_to_taskListFragment"
            app:destination="@id/taskListFragment" />
    </fragment>

    <fragment
        android:id="@+id/taskListFragment"
        android:name="com.example.storevisitmanagement.ui.tasks.TaskListFragment"
        android:label="TaskListFragment"
        tools:layout="@layout/fragment_task_list">
        <argument
            android:name="storeId"
            app:argType="string" />
        <argument
            android:name="storeName"
            app:argType="string" />
        <argument
            android:name="storeCode"
            app:argType="string" />
    </fragment>

</navigation>
